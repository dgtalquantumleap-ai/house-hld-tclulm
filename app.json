
{
  "expo": {
    "name": "HouseHLD",
    "slug": "HouseHLD",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/19eacc08-6026-4431-95bd-02a284b2c783.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/19eacc08-6026-4431-95bd-02a284b2c783.png",
      "resizeMode": "contain",
      "backgroundColor": "#87CEEB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.househld.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/19eacc08-6026-4431-95bd-02a284b2c783.png",
        "backgroundColor": "#87CEEB"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.househld.app"
    },
    "web": {
      "favicon": "./assets/images/19eacc08-6026-4431-95bd-02a284b2c783.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "househld",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
